# Roy Envanter — ortam değişkenleri ÖRNEĞİ (gerçek değer yazmayın, bu dosya GitHub'da herkese açık)
#
# Vercel'de: bu değerleri dosyaya değil, Vercel → Proje → Settings → Environment Variables ekranına girin.
# Yerelde: gerek yok. start.bat SQLite ile çalışır; PIN için start.bat içindeki ROY_PIN satırını kullanın.

# Giriş PIN'i. Vercel'de zorunlu, en az 6 karakter.
ROY_PIN=

# Gece otomatik yedeği için rastgele uzun bir metin (Vercel cron bu değerle kimlik doğrular).
CRON_SECRET=

# Vercel → Storage → Neon eklenince KENDİLİĞİNDEN gelir, elle girmeyin.
DATABASE_URL=

# Vercel → Storage → Blob (Private) eklenince KENDİLİĞİNDEN gelir, elle girmeyin.
BLOB_READ_WRITE_TOKEN=

# --- İsteğe bağlı ---
# Blob deposu Public oluşturulduysa: public
# BLOB_ACCESS=private
# Değiştirilirse tüm cihazlarda oturum kapanır.
# SESSION_SECRET=
# Saat dilimi (varsayılan Europe/Istanbul)
# APP_TZ=Europe/Istanbul
